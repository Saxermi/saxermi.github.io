---
interface Props {
  to: string;
}
const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>Page moved — Michael Saxer</title><meta
      name="robots"
      content="noindex, follow"
    /><meta http-equiv="refresh" content={`0;url=${to}`} /><link
      rel="canonical"
      href={new URL(to, Astro.site)}
    /></head
  ><body
    ><p>
      This page has moved. <a href={to}>Continue to the new page</a>.
    </p></body
  >
</html>
