---
import Arrow from './Arrow.astro';
import { publications } from '../data/publications';
---

<div class="publication-list">
  {
    publications.map((p) => (
      <article class="publication">
        <>
          <p class="eyebrow">Conference paper · {p.year}</p>
          <h3>
            <a href={`https://doi.org/${p.doi}`}>
              {p.title}{' '}
              <span aria-hidden="true">
                <Arrow />
              </span>
            </a>
          </h3>
        </>
        <>
          <p>{p.authors}</p>
          <p class="muted">{p.venue}</p>
          <a class="text-link" href={`https://doi.org/${p.doi}`}>
            DOI: {p.doi}
          </a>
        </>
        <details>
          <>
            <summary>BibTeX citation</summary>
            <pre>
              <code>{p.bibtex}</code>
            </pre>
          </>
        </details>
      </article>
    ))
  }
</div>
