---
import Arrow from '../components/Arrow.astro';
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import { profile } from '../data/profile';
interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'de';
  canonical?: string;
  noindex?: boolean;
}
const {
  title,
  description = profile.description,
  lang = 'en',
  canonical,
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['Projects', '/projects/'],
  ['Study Notes', '/notes/'],
  ['Writing', '/writing/'],
  ['About & CV', '/about/'],
  ['Politics', '/politics/'],
];
const url = new URL(canonical ?? path, Astro.site);
const fullTitle =
  title === 'Michael Saxer'
    ? 'Michael Saxer — Computational science & data science'
    : `${title} — Michael Saxer`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  sameAs: profile.links.map((l) => l.url),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{fullTitle}</title><meta name="description" content={description} />
    <link rel="canonical" href={url} /><link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" /><meta
      property="og:title"
      content={fullTitle}
    />
    <meta property="og:description" content={description} /><meta
      property="og:url"
      content={url}
    />
    <meta
      property="og:image"
      content={new URL('/social-preview.png', Astro.site)}
    /><meta property="og:image:width" content="1200" /><meta
      property="og:image:height"
      content="630"
    /><meta
      property="og:image:alt"
      content="Michael Saxer — computational science, data science and physics"
    />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="google-site-verification"
      content="oko1InTDATkL08uPkxdrfAanD4riI2GAvlkXJTUQ4jI"
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark')
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Michael Saxer — home"
        ><span class="brand-mark" aria-hidden="true">ms.</span><span
          >Michael Saxer</span
        ></a
      >
      <nav aria-label="Main navigation">
        {
          nav.map(([label, href]) => (
            <a
              href={href}
              aria-current={
                path.startsWith(href) ||
                (href === '/about/' && path.startsWith('/cv/'))
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))
        }
      </nav>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch colour theme"
        title="Switch colour theme"
        hidden
        ><svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
          ></path></svg
        ></button
      >
    </header>
    <main class="shell" id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-name" href="/">Michael Saxer</a></div><div
        class="footer-links"
      >
        {
          profile.links.slice(0, 3).map((l) => (
            <a href={l.url}>
              {l.label}{' '}
              <span aria-hidden="true">
                <Arrow />
              </span>
            </a>
          ))
        }
      </div><span class="footer-note">Built with care. Kept simple.</span>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const root = document.documentElement;
          const dark = root.dataset.theme
            ? root.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = dark ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', root.dataset.theme);
          } catch {}
        });
      }
    </script>
  </body>
</html>
