---
import Arrow from '../components/Arrow.astro';
import { Image } from 'astro:assets';
import portrait from '../../public/profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import { getCollection } from 'astro:content';
const projects = await getCollection('project');
const selected = [
  'cms-vertex-reconstruction',
  'biomedical-rag',
  'speech-encoders',
].map((slug) => projects.find((p) => p.slug === slug)!);
---

<BaseLayout title="Michael Saxer">
  <section class="hero" aria-labelledby="intro-title">
    <div>
      <p class="eyebrow blue">Computational science & data science</p><h1
        id="intro-title"
      >
        Michael<br />Saxer<span class="blue">.</span>
      </h1><p class="hero-subtitle">
        Numerical methods, machine learning<br />and the physics behind them.
      </p><div class="hero-identity">
        <Image
          class="hero-portrait"
          src={portrait}
          alt="Michael Saxer outdoors"
          width={160}
          height={160}
          format="webp"
        /><p class="hero-background">
          B.Sc. Data Science · Electronics Engineer (VET)
        </p>
      </div>
    </div>
    <div class="intro">
      <p class="intro-lead">
        I study computational science and engineering at ETH Zürich, with a
        focus on physics.
      </p><p>
        My background is in data science and electronics. For my bachelor thesis
        at the Paul Scherrer Institute, I worked on primary-vertex
        reconstruction for the CMS experiment at CERN.
      </p><p>
        I'm interested in how numerical methods and machine learning can help us
        understand physical systems.
      </p><a class="text-link" href="/about/"
        >More about me & my CV <span aria-hidden="true"><Arrow /></span></a
      >
    </div>
  </section>
  <section class="section" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research & technical projects</p><h2 id="work-title">
          Selected work
        </h2>
      </div><a class="text-link" href="/projects/"
        >All projects <span aria-hidden="true"><Arrow /></span></a
      >
    </div><ProjectList projects={selected} />
  </section>
  <section class="notes-callout" aria-labelledby="notes-title">
    <div>
      <p class="eyebrow">A library for learning</p><h2 id="notes-title">
        Study Notes & resources
      </h2>
    </div><div>
      <p>
        A personal collection of useful videos, lectures and playlists in
        mathematics, statistics and machine learning.
      </p><a class="text-link" href="/notes/"
        >Browse the library <span aria-hidden="true"><Arrow /></span></a
      >
    </div>
  </section>
</BaseLayout>
