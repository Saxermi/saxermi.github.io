---
import Arrow from '../components/Arrow.astro';
import { Image } from 'astro:assets';
import portrait from '../../public/profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import backgroundLinks from '../data/background-links.json';
import Publications from '../components/Publications.astro';
---

<BaseLayout
  title="About"
  description="Michael Saxer: computational science and engineering student at ETH Zürich, with a background in data science and electronics."
  ><header class="page-heading">
    <p class="eyebrow blue">Background & interests</p><h1>About me</h1>
  </header><div class="about-intro">
    <div class="prose">
      <p>
        I am Michael Alexander Saxer. I am studying for an M.Sc. in
        Computational Science and Engineering at ETH Zürich, specializing in
        physics. My interests include numerical methods, computational modeling
        and machine learning.
      </p><p>
        I completed a B.Sc. in Data Science at ZHAW in June 2025. For my
        semester project and bachelor thesis, I worked with the High Energy
        Physics group at the Paul Scherrer Institute on primary-vertex
        reconstruction for the CMS experiment at CERN.
      </p><p>
        Before university, I trained as an electronics engineer at Siemens
        Switzerland. I have also taught mathematics tutorials at ZHAW. Outside
        my studies, I am involved in scouting and <a href="/politics/"
          >local politics</a
        >.
      </p><a class="button" href="/cv/"
        >Read my CV <span aria-hidden="true"><Arrow /></span></a
      >
      <a class="button" href="/cv/michael-saxer-cv.pdf" download
        >Download CV ↓</a
      >
    </div><Image
      class="portrait"
      src={portrait}
      alt="Michael Saxer outdoors"
      width={480}
      height={480}
      format="webp"
      loading="lazy"
    />
  </div><section class="split-section">
    <h2>Publication</h2><Publications />
  </section><section class="split-section">
    <h2>Public profiles</h2><div class="entry">
      <div class="actions" style="margin-top:20px">
        {
          profile.links.map((l) => (
            <a class="text-link" href={l.url}>
              {l.label} <Arrow />
            </a>
          ))
        }
      </div>
    </div>
  </section><section class="split-section">
    <h2>Organisations & training</h2><div class="entry">
      <p class="muted">
        Further information on education, training and organisations from my
        background.
      </p><ul>
        {
          backgroundLinks.map((link) => (
            <li>
              <a href={link.url}>{link.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
