---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  profile,
  education,
  experience,
  activities,
  skills,
  presentations,
} from '../data/profile';
import Publications from '../components/Publications.astro';
---

<BaseLayout
  title="Curriculum vitae"
  description="Education, research, teaching, technical experience and public activities of Michael Alexander Saxer."
  ><header class="page-heading">
    <p class="eyebrow blue">Curriculum vitae</p><h1>
      Michael Alexander Saxer
    </h1><p>B.Sc. Data Science · Electronics Engineer (VET)</p><div
      class="actions"
    >
      <a class="button" href="/cv/michael-saxer-cv.pdf" download
        >Download CV (PDF) ↓</a
      >
    </div>
  </header><div class="page-content">
    <section class="split-section">
      <h2>Education</h2><div>
        {
          education.map((e) => (
            <article class="entry">
              <p class="eyebrow">{e.period}</p>
              <h3>{e.url ? <a href={e.url}>{e.title}</a> : e.title}</h3>
              <p class="organisation">{e.organisation}</p>
              {'status' in e && <p class="blue">{e.status}</p>}
              <p class="muted">{e.description}</p>
            </article>
          ))
        }
      </div>
    </section>
    <section class="split-section">
      <h2>Research experience</h2><div>
        <article class="entry">
          <p class="eyebrow">{experience[0].period}</p><h3>
            {experience[0].title}
          </h3><p class="organisation">{experience[0].organisation}</p><p
            class="muted"
          >
            {experience[0].description}
          </p><ul>
            <li>
              Identified block-border effects as the main reconstruction-quality
              limitation of Deterministic Annealing in Blocks under high-pileup
              conditions.
            </li><li>
              Developed CascadeDA, combining block-wise pre-clustering with
              global deterministic annealing.
            </li><li>
              Achieved 60% faster clustering in the evaluated CMS tracking
              datasets, with sub-10 µm z-resolution and 99% track-to-vertex
              assignment efficiency.
            </li>
          </ul><a class="text-link" href="/projects/cms-vertex-reconstruction/"
            >Project & thesis <Arrow /></a
          >
        </article>
      </div>
    </section>
    <section class="split-section">
      <h2>Teaching & work</h2><div>
        {
          experience.slice(1).map((e) => (
            <article class="entry">
              <>
                <p class="eyebrow">{e.period}</p>
                <h3>{e.title}</h3>
                <p class="organisation">{e.organisation}</p>
                <p class="muted">{e.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="split-section">
      <h2>Publication</h2><Publications />
    </section>
    <section class="split-section">
      <h2>Presentations</h2><div>
        {
          presentations.map((p) => (
            <article class="entry">
              <>
                <p class="eyebrow">{p.date}</p>
                <h3>
                  <a href={p.url}>{p.title}</a>
                </h3>
                <p class="muted">{p.venue}</p>
                <p class="muted">Indico access requires a CERN account.</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="split-section">
      <h2>Selected projects</h2><div>
        <article class="entry">
          <h3>
            <a href="/projects/charged-particle-modeling/"
              >Modeling Charged Particle Motion in Magnetic Fields with FEM and
              PINNs</a
            >
          </h3><p class="muted">
            FEM in NGSolve, fourth-order Runge–Kutta trajectories in Python and
            a PyTorch PINN for the Lorentz force equation. Grade: 6/6.
          </p>
        </article><article class="entry">
          <h3>
            <a href="/projects/speech-encoders/"
              >Layer-wise Analysis of Transformer Models for Speaker
              Identification</a
            >
          </h3><p class="muted">
            Wav2Vec 2.0, XLS-R and Whisper; layer-wise analysis with SVCCA,
            k-means and t-SNE. Grade: 6/6.
          </p>
        </article>
      </div>
    </section>
    <section class="split-section">
      <h2>Awards & activities</h2><div>
        {
          activities.map((a) => (
            <article class="entry">
              <>
                <p class="eyebrow">{a.period}</p>
                <h3>{a.title}</h3>
                <p class="muted">{a.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="split-section">
      <h2>Skills & languages</h2><dl class="skills">
        {
          skills.map(([label, value]) => (
            <>
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            </>
          ))
        }
      </dl>
    </section>
    <section class="split-section">
      <h2>Academic profiles</h2><div class="actions">
        {
          profile.links.map((l) => (
            <a class="text-link" href={l.url}>
              {l.label} <Arrow />
            </a>
          ))
        }
      </div>
    </section>
  </div></BaseLayout
>
