{
  "name": "michael-saxer-website",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/site.test.mjs",
    "test:browser": "playwright test",
    "astro": "astro",
    "test:notes": "node scripts/test-notes.mjs",
    "format": "prettier --write src tests scripts/*.mjs astro.config.mjs playwright.config.ts README.md docs/*.md",
    "format:check": "prettier --check src tests scripts/*.mjs astro.config.mjs playwright.config.ts README.md docs/*.md"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/tailwind": "6.0.2",
    "@fontsource/inter": "5.2.8",
    "astro": "5.18.2",
    "katex": "0.16.28",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  }
}
